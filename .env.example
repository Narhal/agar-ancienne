# Copier en .env et ajuster. Toutes les valeurs ont un défaut raisonnable.
PORT=3000
# Mot de passe admin (commande -login en jeu et page /admin). CHANGEZ-LE.
ADMIN_PASS=changez-moi
# Durée de partie par défaut (minutes) proposée à l'admin
GAME_DURATION_MIN=15
# Intervalle entre deux snapshots du classement (secondes)
SNAPSHOT_INTERVAL_SEC=60
# Formule de fusion des snapshots : somme | moyenne | rangs
SCORE_FORMULA=rangs
# Score final = SNAPSHOT_WEIGHT*score snapshots + FINAL_MASS_WEIGHT*masse finale + KILL_VALUE*kills
SNAPSHOT_WEIGHT=1
FINAL_MASS_WEIGHT=1
KILL_VALUE=50
# Points par rang pour la formule « rangs » (1er, 2e, ...), séparés par des virgules
RANK_POINTS=25,18,15,12,10,8,6,4,2,1
# Rappel (se refondre) : cooldown et durée en secondes
RECALL_COOLDOWN_SEC=8
RECALL_DURATION_SEC=2.5
# Délai de grâce de reconnexion (secondes) avant de perdre sa cellule
RECONNECT_GRACE_SEC=10
# Taille de la carte
GAME_WIDTH=5000
GAME_HEIGHT=5000
# Journaliser le chat dans la console
LOG_CHAT=0
